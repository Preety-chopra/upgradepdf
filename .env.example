PROJECT_NAME=PDF Utility Platform
ENVIRONMENT=production

POSTGRES_DB=pdf_platform
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

UPLOAD_DIR=/app/storage/uploads
OUTPUT_DIR=/app/storage/outputs
OCR_STORAGE_DIR=/app/storage/ocr_jobs

MAX_UPLOAD_SIZE_MB=100
FILE_RETENTION_MINUTES=60

# Leave empty in production so the browser uses the same origin through Nginx.
VITE_API_BASE_URL=
API_WORKERS=1
CELERY_CONCURRENCY=2

# Optional: set these on EC2 to pull prebuilt images from Docker Hub.
# BACKEND_IMAGE=your-dockerhub-user/your-repository:backend
# FRONTEND_IMAGE=your-dockerhub-user/your-repository:frontend
